# dependencies / runtime
node_modules/
*.log

# local state & secrets (never publish)
data/
.env
.claude/settings.local.json
# machine-bound half of the project config: stand URLs, deploy commands, chat ids,
# absolute paths outside the repo. Must be ignored BEFORE the file is ever filled in,
# otherwise the production stand's address rides into git with the first commit.
# The committed halves are .grace/project.md and .grace/local.example.md.
.grace/local.md

# внутренние документы и данные, которые не публикуются (репозиторий публичный):
# отчёты и промты содержат имена клиентских проектов, стоимости прогонов и пути машины,
# мокапы board-v4-* несут вшитый снимок БОЕВОЙ доски (реальные карточки клиента),
# settings.json — помашинные разрешения с абсолютными путями и pid.
docs/
.claude/settings.json
design/board-v4-*.html

# OS / editor cruft
.DS_Store

# local dev scratch (per-machine run artifacts)
.grace-feature-dev/
.playwright-mcp/
dryrun_gfd/

# screenshots: keep only the one the README uses; the rest are unrelated scratch
/*.png
